{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../Sharp.Shared",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "filter": "filterShared.yml",
      "output": "api",
      "outputFormat": "apiPage",
      "namespaceLayout": "nested"
    },
    {
      "src": [
        {
          "src": "../Sharp.Extensions",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "filter": "filterExtensions.yml",
      "output": "api-extensions",
      "outputFormat": "apiPage",
      "namespaceLayout": "nested"
    },
    {
      "src": [
        {
          "src": "../Sharp.Modules",
          "files": [
            "**/Shared/*.csproj"
          ]
        }
      ],
      "filter": "filterModules.yml",
      "output": "api-modules",
      "outputFormat": "apiPage",
      "namespaceLayout": "nested"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "filter*.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "docs/codes/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "ModSharp",
      "_appTitle": "ModSharp",
      "_disableNewTab": false,
      "_disableBreadcrumb": false,
      "_disableToc": false,
      "_disableAffix": false,
      "_disableNextArticle": true,
      "_enableSearch": true,
      "_lang": "zh-cn",
      "_appLogoPath": "images/icon.svg",
      "_appFaviconPath": "images/icon.svg",
      "_appFooter": "<span>ModSharp by <a href=\"https://github.com/Kxnrl/modsharp-public\">ModSharp dev team</a>. Doc made with <a href=\"https://dotnet.github.io/docfx\">docfx</a></span>",
      "pdf": false
    },
    "fileMetadata": {
      "_lang": {
        "docs/zh-cn/**": "zh-cn",
        "docs/en-us/**": "en-us"
      }
    }
  }
}