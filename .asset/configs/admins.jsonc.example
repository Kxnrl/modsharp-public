/*
 * PermissionCollection: The base data of the permission, all 'access' will be checked against this collection.
 * Roles: Collections of permissions, which can be assigned to Admins.
 * Admins: Users with assigned roles and permissions.
 */

/*
 * General Rules:
 *   1. Case Insensitivity: 'Admin:Kick' is the same as 'admin:kick'.
 *   2. Identity Format: Must be strictly SteamID64 format in integer (e.g. steamcommunity/profiles/76561198000000001).
 *      Do not use legacy STEAM_0:X:Y formats, or SteamID3 format ([U:1:AccountId])
 *
 * Permission Syntax:
 *   @RoleName   = Inherit permissions from role (Recursive)
 *   !permission = Deny permission (global, overrides grants)
 *   *           = All permissions
 *   module:*    = All permissions in module (Recursive: matches 'module:a' and 'module:a:b')
 * 
 * Immunity: Higher = more protection. Takes max from all roles/direct.
 */
{
    "PermissionCollection": {
        "admin": ["admin:kick", "admin:ban", "admin:slay"],
        "vip": ["vip:skins", "vip:reserved_slot"]
    },

    "Roles": [
        {
            // Full access, highest immunity
            "Name": "root",
            "Immunity": 255, // maximum immunity is 255
            "Permissions": ["*"]
        },
        {
            // All admin permissions
            "Name": "admin",
            "Immunity": 50,
            "Permissions": ["admin:*"]
        },
        {
            // ROLE INHERITANCE & SUBTRACTION:
            // Inherits 'admin' but specifically REMOVES the ban permission.
            "Name": "junior_admin",
            "Immunity": 25,
            "Permissions": ["@admin", "!admin:ban"]
        },
        {
            // VIP perks only, no immunity specified (defaults to 0)
            "Name": "vip",
            "Permissions": ["vip:*"]
        },
        {
            // Example of mixing wildcards and specific single permissions
            "Name": "vip_plus",
            "Permissions": ["vip:*", "custom:chat_color"]
        }
    ],
    
    /*
     * MULTI-MODULE BEHAVIOR FOR ADMINS:
     * If the same Identity (SteamID) appears in multiple module configs:
     * 1. MERGING: The user gets the combined permissions of ALL entries.
     * 2. IMMUNITY: The user gets the HIGHEST immunity value found across all entries.
     * 3. DENIALS: A '!permission' here overrides grants from ANY other module.
     */
    "Admins": [
        {
            // Server owner with root access
            "Identity": 76561198000000001,
            "Permissions": ["@root"]
        },
        {
            // Admin who cannot ban
            // NOTE: If another module tries to give this user "admin:ban", 
            // the "!admin:ban" here will override it and force a denial.
            "Identity": 76561198000000002,
            "Permissions": ["@admin", "!admin:ban"]
        },
        {
            // VIP with extra kick permission and custom immunity
            // NOTE: If another module defines this user with Immunity 10,
            // the value 20 here will take precedence (Max wins).
            "Identity": 76561198000000003,
            "Immunity": 20,
            "Permissions": ["@vip", "admin:kick"]
        }
    ]
}
