<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>ExtraAddonManager</AssemblyName>
        <RootNamespace>Sharp.Modules.ExtraAddonManager</RootNamespace>
        <Description>Extra Addon Manager Module for ModSharp, a MultiAddonManager equivalent.</Description>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <BaseOutputPath>../../../.build/Sharp.Modules/ExtraAddonManager/</BaseOutputPath>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Sharp.Shared\Sharp.Shared.csproj" Private="false" ExcludeAssets="runtime"/>
        <ProjectReference Include="..\Shared\Sharp.Modules.ExtraAddonManager.Shared.csproj" Private="false" ExcludeAssets="runtime"/>
    </ItemGroup>

</Project>
